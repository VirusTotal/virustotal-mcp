{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.VirusTotal/virustotal-mcp",
  "title": "VirusTotal",
  "description": "VirusTotal reports for files, URLs, domains and IPs, plus file submission and analysis recovery.",
  "version": "0.8.5",
  "websiteUrl": "https://ai.virustotal.com/connect/mcp",
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "vt-mcp",
      "version": "0.8.4",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "VTAI_TOKEN_FILE",
          "description": "Path to a protected file containing only your VTAI token. Get free access at https://ai.virustotal.com/connect/mcp.",
          "format": "filepath",
          "isRequired": true,
          "placeholder": "/home/user/.config/vt-mcp/token"
        }
      ],
      "runtimeArguments": [
        {
          "type": "named",
          "name": "--python",
          "value": "3.12"
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://ai.virustotal.com/mcp"
    }
  ],
  "icons": [
    {
      "src": "https://ai.virustotal.com/logo.svg",
      "mimeType": "image/svg+xml",
      "sizes": [
        "any"
      ]
    }
  ]
}
