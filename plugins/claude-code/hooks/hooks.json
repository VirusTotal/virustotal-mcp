{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^mcp__(plugin_virustotal_virustotal|claude_ai_([Vv][Ii][Rr][Uu][Ss][Tt][Oo][Tt][Aa][Ll]|[Aa][Ii]_[Vv][Ii][Rr][Uu][Ss][Tt][Oo][Tt][Aa][Ll]_[Cc][Oo][Mm]))__submit_file$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/expand-file.mjs"],
            "timeout": 60
          }
        ]
      }
    ]
  }
}
